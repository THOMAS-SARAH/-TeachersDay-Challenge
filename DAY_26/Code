import java.util.Scanner;

public class OrangeCocktail {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(); // Number of drinks
        double sum = 0;

        for (int i = 0; i < n; i++) {
            sum += sc.nextInt(); // Add the percent for each drink
        }

        double average = sum / n; // Calculate average
        System.out.printf("%.10f\n", average); // Print answer with high precision
    }
}
