import java.util.Scanner;

public class BearAndBigBrother {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        int a = scanner.nextInt();  // Limak's initial weight
        int b = scanner.nextInt();  // Bob's initial weight
        
        int years = 0;
        
        // Increase weights yearly until Limak is strictly heavier than Bob
        while (a <= b) {
            a *= 3;
            b *= 2;
            years++;
        }
        
        System.out.println(years);
        scanner.close();
    }
}
